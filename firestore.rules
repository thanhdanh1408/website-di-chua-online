rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /user_states/{uid} {
      allow read, create, update: if owner(uid) || admin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid) && googleUser()
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'provider', 'createdAt', 'lastSeenAt'])
        && request.resource.data.provider == 'google.com';
      allow delete: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if owner(uid) && googleUser()
        && request.resource.data.keys().hasOnly(['name', 'merit', 'updatedAt'])
        && request.resource.data.merit is number;
      allow create, update: if admin();
      allow delete: if false;
    }

    match /wishes/{wishId} {
      allow read: if admin()
        || resource.data.status == 'approved'
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if googleUser()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 280
        && request.resource.data.reactions.size() == 0
        && request.resource.data.reports.size() == 0;
      allow update: if admin() || validReaction() || validReport();
      allow delete: if false;
    }

    function validReaction() {
      return signedIn()
        && resource.data.status == 'approved'
        && resource.data.authorId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.hasAll(resource.data.reactions)
        && request.resource.data.reactions.size() == resource.data.reactions.size() + 1
        && request.resource.data.reactions.hasAny([request.auth.uid]);
    }

    function validReport() {
      return signedIn()
        && resource.data.status == 'approved'
        && resource.data.authorId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'status'])
        && request.resource.data.reports.hasAll(resource.data.reports)
        && request.resource.data.reports.size() == resource.data.reports.size() + 1
        && request.resource.data.reports.hasAny([request.auth.uid])
        && (request.resource.data.status == resource.data.status
          || (request.resource.data.reports.size() >= 3 && request.resource.data.status == 'hidden'));
    }
  }
}
