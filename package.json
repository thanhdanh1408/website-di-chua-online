{
  "name": "di-chua-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "firebase:set-admin": "node --env-file=.env.admin.local scripts/set-admin.mjs",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-di-chua-online \"vitest run tests/firestore.rules.test.ts\"",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:firebase-auth": "node scripts/check-google-auth.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "date-fns": "latest",
    "firebase": "^13.0.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "latest",
    "lunar-typescript": "^1.8.6",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "firebase-admin": "^14.5.0",
    "globals": "latest",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
